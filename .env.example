# Copy to .env (never commit .env).

# Claude. Leave empty to run in no-LLM mode: figures are keyed in on review and narrative is written by hand.
ANTHROPIC_API_KEY=

# Force no-LLM mode even when a key is set (1 = off).
BIZWAVE_NO_LLM=0

# Turn off individual registered uses, comma separated, e.g. narrative.draft,flags.cim_qualitative
BIZWAVE_LLM_DISABLED_USES=

# Model for all registered uses unless a use overrides it.
BIZWAVE_LLM_MODEL=claude-sonnet-5-5

# Where the run log (every Claude call, prompt version, timings) is written.
BIZWAVE_RUNLOG=deals/runlog.jsonl
