# Copy to .env in the repository folder (never commit .env). Every line is optional.
# A variable already set in your environment wins over this file.
# Use absolute paths: a relative path is taken from whatever folder a command runs in.

# --- Where things live -------------------------------------------------------------------
# Data folder for client files, the run log and the database. Must be OUTSIDE the repository
# (refused otherwise), and not inside OneDrive, Dropbox, Google Drive or iCloud (sync can corrupt
# the open database; you get a warning).
# Default: C:\Users\<you>\BizWaveData on Windows, ~/BizWaveData on a Mac.
BIZWAVE_DATA_DIR=

# Run log of every Claude call. Leave empty for <data folder>/runlog.jsonl.
# A path inside the repository is refused.
BIZWAVE_RUNLOG=

# Database (used from packet P2). Default: sqlite:///<data folder>/bizwave.db
BIZWAVE_DATABASE_URL=

# Where `bw backup` (and the automatic backup before a database upgrade) writes: a database snapshot
# plus a copy of the deal files. Point it at your ENCRYPTED backup folder; a synced folder is fine
# here. Refused inside the repository. Default: <data folder>/backups (same disk: you get a warning).
# It holds a copy of every client file: if you set it, add a matching Read(...) deny rule to
# .claude/settings.json, as for a moved data folder.
BIZWAVE_BACKUP_DIR=

# --- Claude --------------------------------------------------------------------------------
# Leave empty to run in no-LLM mode: figures are keyed in on review and narrative is written by hand.
ANTHROPIC_API_KEY=

# Force no-LLM mode even when a key is set (1/true/yes/on).
BIZWAVE_NO_LLM=0

# Turn off individual registered uses, comma separated, e.g. narrative.draft,flags.cim_qualitative
BIZWAVE_LLM_DISABLED_USES=

# Model for all registered uses. Default: claude-sonnet-5-5
BIZWAVE_LLM_MODEL=

# To ignore this file entirely, set BIZWAVE_LOAD_DOTENV=0 in your SHELL environment, not here:
# a value in this file cannot switch the file off. The test suite always sets it.
