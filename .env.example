# Copy to .env in the repository folder (never commit .env). Every line is optional.
# A variable already set in your environment wins over this file.

# --- Where things live -------------------------------------------------------------------
# Data folder for client files, the run log and the database. Must be OUTSIDE the repository,
# and not inside OneDrive/Dropbox (sync can corrupt the open database).
# Default: C:\Users\<you>\BizWaveData on Windows, ~/BizWaveData on a Mac.
BIZWAVE_DATA_DIR=

# Run log of every Claude call. Default: <data folder>/runlog.jsonl
BIZWAVE_RUNLOG=

# Database (used from packet P2). Default: sqlite:///<data folder>/bizwave.db
BIZWAVE_DATABASE_URL=

# --- Claude --------------------------------------------------------------------------------
# Leave empty to run in no-LLM mode: figures are keyed in on review and narrative is written by hand.
ANTHROPIC_API_KEY=

# Force no-LLM mode even when a key is set (1/true/yes/on).
BIZWAVE_NO_LLM=0

# Turn off individual registered uses, comma separated, e.g. narrative.draft,flags.cim_qualitative
BIZWAVE_LLM_DISABLED_USES=

# Model for all registered uses. Default: claude-sonnet-5-5
BIZWAVE_LLM_MODEL=

# --- This file -----------------------------------------------------------------------------
# Set to 0 to ignore this file (the test suite always does).
BIZWAVE_LOAD_DOTENV=1
