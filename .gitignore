# Client data never goes into git. Live deals live in BIZWAVE_DATA_DIR outside the repository;
# deals/ stays ignored as a safety net in case a client file lands here by mistake.
deals/*
!deals/README.md
*.pdf
!tests/fixtures/**/*.pdf

# Secrets and local settings
.env
.env.*
!.env.example

# Run log (contains prompts and model outputs for client deals)
runlog*.jsonl

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
build/
dist/

# Office lock and temp files
~$*
.~lock.*#

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local database files (the live database lives in BIZWAVE_DATA_DIR, outside the repo)
*.db
*.sqlite
*.sqlite3
# SQLite's companion files: the WAL holds the most recent writes
*.db-wal
*.db-shm
*.db-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.sqlite3-wal
*.sqlite3-shm
*.sqlite3-journal

# Personal Claude Code settings (the shared .claude/settings.json is committed)
.claude/settings.local.json
